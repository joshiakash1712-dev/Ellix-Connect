# PORT: Port the local/standalone server listens on (ignored in Cloud Functions).
PORT=3000

# FIREBASE_PROJECT_ID: Firebase project used by the Admin SDK.
# Defaults to nice-unity-1mbw7 when unset.
FIREBASE_PROJECT_ID=

# FIRESTORE_DATABASE_ID: Firestore database used by the Admin SDK.
# Defaults to ai-studio-ellixconnect-badaa1a3-33f3-40fb-a0e7-a5f5c05ebc53 when unset.
FIRESTORE_DATABASE_ID=

# GOOGLE_APPLICATION_CREDENTIALS: Path to a service account JSON key.
# Only needed when the Admin SDK runs outside Google Cloud (e.g. local development).
GOOGLE_APPLICATION_CREDENTIALS=

# APP_URL: Optional canonical public URL of the deployment (e.g. https://<your-project>.web.app).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# RAZORPAY_KEY_ID: Razorpay API Key ID for billing/subscription payment processing
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: Razorpay API Key Secret for order creation & refunds
RAZORPAY_KEY_SECRET=

# RAZORPAY_WEBHOOK_SECRET: Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=
